    "in-a-place": {
      "title": "Yn …",
      "order": "the sounds that change first (c, b, t, p), then the names that do not",
      "intro": "After {{yn}} (in) the first letter of a place name changes, as with the parts of Wales on the Compass: {{Caerdydd}} becomes {{Nghaerdydd}}. The plain name is listed as another way it is heard.",
      "concepts": {
        "in-cardiff": {
          "text": "Yng Nghaerdydd",
          "keys": [
            "Nghaerdydd"
          ],
          "also": [
            "Caerdydd"
          ],
          "note": "{{c}} becomes {{ngh}} after {{yn}}, and {{yn}} becomes {{yng}}"
        },
        "in-newport": {
          "text": "Yng Nghasnewydd",
          "keys": [
            "Nghasnewydd"
          ],
          "also": [
            "Casnewydd"
          ]
        },
