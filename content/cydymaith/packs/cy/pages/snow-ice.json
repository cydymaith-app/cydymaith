{
  "title": "Eira a rhew",
  "source": "draft",
  "sections": {
    "snow": {
      "title": "Eira",
      "concepts": {
        "snow-showers-on-the-mountains": {
          "text": "Cawodydd eira ar y mynyddoedd"
        },
        "sleet-on-lower-ground": {
          "text": "Eirlaw ar dir is"
        },
        "the-odd-hail-shower": {
          "text": "Ambell gawod o genllysg",
          "note": "{{cenllysg}} is hail; it softens to {{genllysg}} after {{o}}"
        },
        "snow-settling-overnight": {
          "text": "Eira yn setlo dros nos",
          "note": "{{setlo}}: to settle, to lie; to be confirmed"
        },
        "a-yellow-warning-for-snow": {
          "text": "Rhybudd melyn am eira"
        }
