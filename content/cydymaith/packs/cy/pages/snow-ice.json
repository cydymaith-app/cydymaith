      "order": "snow, then sleet and hail, then the warning"
    },
    "frost-ice": {
      "title": "Rhew ac iâ",
      "concepts": {
        "a-hard-frost-in-places": {
          "text": "Rhew caled mewn mannau"
        },
        "hoar-frost-on-the-fields": {
          "text": "Barrug ar y caeau",
          "note": "{{barrug}}: hoar frost, rime; to be confirmed"
        },
        "icy-roads-in-the-morning": {
          "text": "Ffyrdd rhewllyd yn y bore"
        },
        "a-yellow-warning-for-ice": {
