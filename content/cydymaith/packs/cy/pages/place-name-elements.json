        "valley": {
          "text": "cwm",
          "note": "as in {{Cwmbrân}}"
        },
        "moorland": {
          "text": "gwaun",
          "note": "as in {{Gwauncaegurwen}}",
          "also": [
            "waun"
          ]
        },
        "open-field": {
          "text": "maes",
          "note": "as in {{Maesteg}}"
        },
        "moor": {
          "text": "rhos",
          "note": "as in {{Rhosneigr}}"
