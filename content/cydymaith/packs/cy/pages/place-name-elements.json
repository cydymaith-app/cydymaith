      }
    },
    "water": {
      "title": "Dŵr",
      "order": "alphabetical, in the Welsh alphabet",
      "concepts": {
        "river-mouth": {
          "text": "aber",
          "note": "as in {{Aberystwyth}}, {{Abertawe}} and {{Aberteifi}}; the river's name follows"
        },
        "river": {
          "text": "afon",
          "note": "as in {{Afon Conwy}}"
        },
        "spring": {
          "text": "ffynnon",
          "note": "as in {{Ffynnon Taf}}"
        },
        "bank-shore": {
          "text": "glan",
          "also": [
            "lan"
          ],
          "note": "as in {{glan y môr}} (the seashore), {{glan llyn}} (the lakeside) and {{glan yr afon}} (the riverside); in place names often with hyphens, as {{Glan-y-môr}}"
        },
        "lake": {
          "text": "llyn",
          "note": "as in {{Llyn Tegid}}"
        },
        "brook": {
