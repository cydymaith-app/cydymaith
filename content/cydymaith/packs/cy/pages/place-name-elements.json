        },
        "hill": {
          "text": "bryn",
          "note": "as in {{Bryn Mawr}}"
        },
        "pass": {
          "text": "bwlch",
          "note": "as in {{Bwlch y Groes}}"
        },
        "cairn": {
          "text": "carn",
          "note": "as in {{Carn Ingli}}"
        },
        "crag": {
          "text": "craig",
          "note": "as in {{Craig-y-nos}}",
          "also": [
            "graig"
          ]
        },
        "bare-hill": {
          "text": "moel",
          "note": "as in {{Moel Famau}}",
          "also": [
            "foel"
          ]
        },
        "mountain": {
          "text": "mynydd",
          "note": "as in {{Mynydd Du}}"
        },
        "head-top": {
          "text": "pen",
          "note": "as in {{Penarth}} and {{Pen-y-bont ar Ogwr}}"
        }
      }
    },
