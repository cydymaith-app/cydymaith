{
  "title": "Glaw a stormydd",
  "source": "draft",
  "sections": {
    "rain": {
      "title": "Glaw",
      "concepts": {
        "drizzle-here-and-there": {
          "text": "Glaw mân yma ac acw"
        },
        "only-a-few-showers": {
          "text": "Dim ond rhai cawodydd"
        },
        "heavy-showers-in-the-afternoon": {
          "text": "Cawodydd trwm yn y prynhawn"
        },
        "spells-of-heavy-rain-as-well": {
          "text": "Cyfnodau o law trwm hefyd",
          "note": "{{glaw}} softens to {{law}} after {{o}}",
          "also": [
            "chyfnodau o law trwm"
          ]
        },
        "possibly-heavy-at-times": {
          "text": "O bosib yn drwm ar adegau",
          "also": [
            "o bosibl"
          ]
        },
        "heavy-rain-and-strong-wind": {
          "text": "Glaw trwm a gwynt cryf"
        },
        "a-yellow-warning-for-rain": {
          "text": "Rhybudd melyn am law",
          "note": "{{am}} softens {{glaw}} to {{law}}"
        },
        "a-risk-of-flooding": {
          "text": "Perygl o lifogydd",
          "note": "{{llifogydd}} softens to {{lifogydd}} after {{o}}"
        }
      },
      "order": "lightest to heaviest, then the warning and the flooding"
    },
    "storms": {
      "title": "Mellt a tharanau",
      "concepts": {
        "a-chance-of-thunder-and-lightning": {
          "text": "Posibilrwydd o fellt a tharanau"
        },
        "the-odd-thunderstorm": {
          "text": "Ambell storm o fellt a tharanau"
        },
        "more-rough-weather-over-the-next-few-hours": {
          "text": "Rhagor o dywydd garw dros yr oriau nesaf"
        },
        "two-storms-in-one-weekend": {
          "text": "Dwy storm mewn un penwythnos",
          "note": "{{dwy}} is two before a feminine noun"
        }
      },
      "order": "thunder and lightning, then storms and rough weather"
    }
  }
}
