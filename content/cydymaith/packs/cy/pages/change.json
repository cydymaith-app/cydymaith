{
  "title": "Newid a symud",
  "source": "draft",
  "sections": {
    "pressure": {
      "title": "Gwasgedd",
      "concepts": {
        "high-pressure-in-charge": {
          "text": "Gwasgedd uchel yn rheoli",
          "note": "{{rheoli}}: to control, to dominate"
        },
        "a-ridge-of-high-pressure-moving-in": {
          "text": "Cefnlen o wasgedd uchel yn symud i mewn",
          "note": "{{cefnlen}} is a ridge; the meaning is to be confirmed"
        },
        "an-area-of-intense-low-pressure": {
          "text": "Ardal o wasgedd isel dwys",
          "note": "{{dwys}} means intense, deep",
          "also": [
            "ardal o wasgedd isel"
          ]
        },
        "low-pressure-bringing-rain": {
          "text": "Gwasgedd isel yn dod â glaw"
        }
      },
      "order": "high, then low"
    },
    "moving": {
      "title": "Y tywydd yn symud",
      "concepts": {
        "hitting-the-west-first": {
          "text": "Yn taro'r gorllewin yn gyntaf"
        },
        "arriving-by-the-morning": {
          "text": "Yn cyrraedd erbyn y bore"
        },
        "spreading-eastwards": {
          "text": "Yn lledu tua'r dwyrain",
          "also": [
            "ymledu"
          ]
        },
        "extending-over-towards-anglesey": {
          "text": "Yn ymestyn draw tuag at Ynys Môn"
        },
        "moving-in-from-the-west": {
          "text": "Yn symud o gyfeiriad y gorllewin"
        },
        "the-rain-clearing-away": {
          "text": "Y glaw yn cilio"
        },
        "leaving-us-overnight": {
          "text": "Yn ein gadael ni dros nos",
          "also": [
            "i adael"
          ]
        }
      },
      "order": "arriving, spreading, then leaving"
    },
    "which-way": {
      "title": "I ba gyfeiriad",
      "concepts": {
        "towards-the-east": {
          "text": "I gyfeiriad y dwyrain"
        },
        "from-the-direction-of-ireland": {
          "text": "O gyfeiriad Iwerddon"
        },
        "across-the-country": {
          "text": "Ar draws y wlad"
        },
        "over-towards-the-north-east": {
          "text": "Draw tuag at y gogledd-ddwyrain"
        },
        "more-rain-on-the-way": {
          "text": "Rhagor o law ar y ffordd",
          "note": "{{ar y ffordd}} could also be on the road; to be confirmed"
        },
        "in-the-west-of-the-country": {
          "text": "Yng ngorllewin y wlad",
          "note": "after {{yn}} (in) {{gorllewin}} becomes {{ngorllewin}}"
        }
      },
      "order": "towards, from, across, then where"
    },
    "changing": {
      "title": "Y tywydd yn newid",
      "concepts": {
        "changing-by-the-weekend": {
          "text": "Yn newid erbyn y penwythnos"
        },
        "turning-more-unsettled": {
          "text": "Yn troi'n fwy ansefydlog"
        },
        "showers-developing-in-the-afternoon": {
          "text": "Cawodydd yn datblygu yn y prynhawn"
        },
        "showers-getting-heavier": {
          "text": "Cawodydd yn mynd yn drymach"
        },
        "the-wind-easing-by-dawn": {
          "text": "Y gwynt yn gostegu erbyn iddi wawrio",
          "note": "{{gostegu}}: to ease; {{gwawrio}}: to dawn"
        },
        "calming-down-overnight": {
          "text": "Yn tawelu dros nos"
        },
        "clouding-over-from-the-west": {
          "text": "Yn cymylu o'r gorllewin"
        },
        "brightening-up-by-the-afternoon": {
          "text": "Yn brafio erbyn y prynhawn"
        },
        "if-it-were-to-settle-a-little": {
          "text": "Pe bai hi'n sefydlogi ryw fymryn"
        }
      },
      "order": "changing, stronger, weaker, then the sky"
    },
    "other-verbs": {
      "title": "Berfau eraill",
      "concepts": {
        "strong-winds-are-expected": {
          "text": "Mae disgwyl gwyntoedd cryfion",
          "also": [
            "'dan ni'n disgwyl"
          ]
        },
        "the-rain-will-continue-all-day": {
          "text": "Bydd y glaw yn parhau drwy'r dydd"
        },
        "varying-from-place-to-place": {
          "text": "Yn amrywio o le i le"
        },
        "coinciding-with-high-tide": {
          "text": "Yn cyd-fynd â'r llanw uchel",
          "also": [
            "cyd-fynd hefo"
          ]
        },
        "we-could-see": {
          "text": "Gallen ni weld …",
          "also": [
            "gallwn ni weld"
          ]
        },
        "we-saw-gusts-of-84-mph": {
          "text": "Mi welon ni hyrddiadau o 84 milltir yr awr"
        },
        "the-rest-of-the-week-looks-dry": {
          "text": "Mae gweddill yr wythnos yn edrych yn sych"
        },
        "affecting-the-roads": {
          "text": "Yn effeithio ar y ffyrdd"
        }
      },
      "order": "expecting and continuing, then seeing and affecting"
    }
  }
}
