    "hot-cold": {
      "title": "Poeth ac oer",
      "concepts": {
        "warm-for-the-time-of-year": {
          "text": "Cynnes am yr adeg o'r flwyddyn"
        },
        "mild-on-the-whole": {
          "text": "Mwyn ar y cyfan"
        },
        "feeling-fresh-in-the-wind": {
          "text": "Teimlo'n ffres yn y gwynt"
        },
        "colder-than-yesterday": {
          "text": "Oerach na ddoe"
        },
        "another-cold-night": {
          "text": "Noson oer arall"
        }
      },
      "order": "warmest to coldest"
    },
    "humidity": {
      "title": "Pa mor llaith",
      "concepts": {
        "it-should-turn-drier": {
          "text": "Dylai hi droi'n sychach",
          "also": [
            "ddylai hi droi'n sychach"
          ]
        },
        "damp-and-grey": {
          "text": "Llaith a llwydaidd"
        },
        "close-humid-weather": {
          "text": "Tywydd mwll a llaith"
        },
        "high-humidity-in-the-afternoon": {
          "text": "Lleithder uchel yn y prynhawn"
        }
      },
      "order": "dry to muggy"
    },
    "limits": {
      "title": "Graddau a therfynau",
      "concepts": {
        "temperatures-at-their-highest-in-the-afternoon": {
          "text": "Y tymheredd ar ei uchaf yn y prynhawn",
          "note": "{{ar ei}} means at its; the same pattern gives {{ar ei isaf}}"
        },
        "a-high-of-16-degrees": {
          "text": "Uchafbwynt o 16 gradd",
          "note": "after a number the noun stays singular: {{gradd}}"
        },
        "as-high-as-13-degrees-in-the-south": {
          "text": "Mor uchel â 13 gradd yn y de"
        },
        "at-its-lowest-between-6-and-9-degrees": {
          "text": "Ar ei isaf rhwng 6 a 9 gradd"
        },
        "the-temperature-falling-fast-in-the-evening": {
          "text": "Y tymheredd yn syrthio'n gyflym gyda'r nos"
        },
        "a-few-degrees-below-freezing": {
          "text": "Ychydig raddau islaw'r rhewbwynt",
          "note": "{{ychydig}} softens {{graddau}} to {{raddau}}"
        }
      },
      "order": "highs, then lows"
    }
  }
